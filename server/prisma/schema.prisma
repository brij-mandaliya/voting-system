generator client {
  provider = "prisma-client-js"
  // `native` for local/dev; `rhel-openssl-3.0.x` is the AWS Lambda runtime that
  // Netlify Functions use (Amazon Linux 2023, OpenSSL 3).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users / auth
// ---------------------------------------------------------------------------
model User {
  id                  String   @id @default(cuid())
  name                String
  username            String   @unique
  email               String   @unique
  passwordHash        String
  role                Role     @default(PARTICIPANT)
  status              UserStat @default(ACTIVE)
  mustChangePassword  Boolean  @default(false)
  /// false for accounts that only sign in with Google (their passwordHash is random and never shown)
  hasPassword         Boolean  @default(true)
  teamId              String?
  team                Team?    @relation("orgTeam", fields: [teamId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  sessions            Session[]
  memberships         RoomMember[]
  votes               Vote[]   @relation("voter")
  auditLogs           AuditLog[]
  importJobs          ImportJob[]
  createdRooms        Room[]   @relation("roomCreator")

  @@index([status])
}

enum Role {
  ADMIN
  MODERATOR
  PARTICIPANT
}

enum UserStat {
  ACTIVE
  INACTIVE
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Org-level teams
// ---------------------------------------------------------------------------
model Team {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  projectTitle String?
  links        Json     @default("[]")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  members      User[]       @relation("orgTeam")
  roomTeams    RoomTeam[]
  voteTargets  Vote[]
  roomMemberLinks RoomMember[] @relation("roomMemberTeam")
  rounds       VotingRound[] @relation("roundTeam")
}

// ---------------------------------------------------------------------------
// Rooms
// ---------------------------------------------------------------------------
model Room {
  id                String     @id @default(cuid())
  name              String
  description       String?
  joinCode          String     @unique
  joinCodeExpiresAt DateTime?
  joinCodeEnabled   Boolean    @default(true)
  accessMode        AccessMode @default(RESTRICTED)
  status            RoomStat   @default(DRAFT)
  settings          Json       @default("{\"allowVoteEdit\":true,\"adminCanSeeVoterIdentity\":true,\"liveResults\":false,\"minVotesThreshold\":0,\"aggregationMethod\":\"weighted_mean\"}")
  publishedAt       DateTime?
  createdById       String
  createdBy         User       @relation("roomCreator", fields: [createdById], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  members           RoomMember[]
  roomTeams         RoomTeam[]
  categories        Category[]
  configVersions    RoomConfigVersion[]
  rounds            VotingRound[]
  votes             Vote[]

  @@index([status])
}

enum RoomStat {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AccessMode {
  RESTRICTED
  OPEN_WITH_CODE
}

model RoomMember {
  id        String     @id @default(cuid())
  roomId    String
  userId    String
  role      MemberRole @default(PARTICIPANT)
  teamId    String?
  createdAt DateTime   @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation("roomMemberTeam", fields: [teamId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

enum MemberRole {
  PARTICIPANT
  MODERATOR
}

model RoomTeam {
  id                String  @id @default(cuid())
  roomId            String
  teamId            String
  presentationOrder Int     @default(0)
  details           String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id])

  rounds VotingRound[]

  @@unique([roomId, teamId])
  @@unique([teamId, roomId])
  @@index([roomId, presentationOrder])
}

// ---------------------------------------------------------------------------
// Category configuration, versioned per room
// ---------------------------------------------------------------------------
model RoomConfigVersion {
  id        String   @id @default(cuid())
  roomId    String
  version   Int
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  reason    String?

  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  categories Category[] @relation("version")
  rounds     VotingRound[]

  @@unique([roomId, version])
  @@unique([id, roomId])
  @@index([roomId, isCurrent])
}

model Category {
  id              String  @id @default(cuid())
  roomId          String
  configVersionId String
  name            String
  description     String?
  minScore        Int     @default(1)
  maxScore        Int     @default(10)
  step            Int     @default(1)
  weight          Decimal @default(1.0) @db.Decimal(8, 4)
  isRequired      Boolean @default(true)
  displayOrder    Int     @default(0)
  active          Boolean @default(true)
  createdAt       DateTime @default(now())

  room          Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  configVersion RoomConfigVersion @relation("version", fields: [configVersionId, roomId], references: [id, roomId])
  voteScores    VoteScore[]

  @@unique([id, roomId])
  @@index([roomId, displayOrder])
  @@index([configVersionId])
}

// ---------------------------------------------------------------------------
// Voting
// ---------------------------------------------------------------------------
model VotingRound {
  id              String     @id @default(cuid())
  roomId          String
  teamId          String
  status          RoundStat  @default(PENDING)
  configVersionId String
  openedAt        DateTime?
  closedAt        DateTime?
  reopenedCount   Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  room           Room                @relation(fields: [roomId], references: [id])
  team           Team                @relation("roundTeam", fields: [teamId], references: [id])
  configVersion  RoomConfigVersion   @relation(fields: [configVersionId, roomId], references: [id, roomId])
  roomTeam       RoomTeam            @relation(fields: [teamId, roomId], references: [teamId, roomId])
  votes          Vote[]

  @@unique([id, roomId])
  @@index([roomId, status])
  @@index([teamId])
}

enum RoundStat {
  PENDING
  OPEN
  PAUSED
  CLOSED
}

model Vote {
  id          String   @id @default(cuid())
  roundId     String
  roomId      String
  teamId      String
  voterId     String
  revision    Int      @default(1)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  round    VotingRound @relation(fields: [roundId, roomId], references: [id, roomId])
  room     Room        @relation(fields: [roomId], references: [id])
  team     Team        @relation(fields: [teamId], references: [id])
  voter    User        @relation("voter", fields: [voterId], references: [id])
  scores   VoteScore[]

  @@unique([roundId, voterId])
  @@index([roomId, teamId])
  @@index([voterId])
}

model VoteScore {
  id         String  @id @default(cuid())
  voteId     String
  categoryId String
  roomId     String
  score      Decimal @db.Decimal(6, 2)

  vote     Vote     @relation(fields: [voteId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, roomId], references: [id, roomId])

  @@unique([voteId, categoryId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Audit + imports
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model ImportJob {
  id          String     @id @default(cuid())
  filename    String
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  status      ImportStat @default(PENDING)
  report      Json?
  createdAt   DateTime   @default(now())

  @@index([createdById])
}

enum ImportStat {
  PENDING
  PREVIEWED
  COMMITTED
  FAILED
}
